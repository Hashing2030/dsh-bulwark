{
  "name": "dsh-plugin-client-template",
  "version": "0.1.0",
  "description": "DSH 客户端端插件：浏览器半区 Canvas 交互 + Node 半区空插件",
  "type": "module",
  "main": "./dist/host.js",
  "types": "./dist/host.d.ts",
  "exports": {
    ".": "./dist/host.js",
    "./client": "./dist/index.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "dsh-client"
  ],
  "license": "MIT",
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-runtime": "*"
  },
  "dependencies": {}
}
