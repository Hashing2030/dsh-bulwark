{
  "name": "dsh-bulwark",
  "version": "0.1.0",
  "description": "DSH plugin: rule injection + tool/path protection",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "guard",
    "protection"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.yml",
    "scripts/protect.sh",
    "CONFIG.md",
    "DISASTER-RECOVERY.md",
    "SCRIPT-USAGE.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node --experimental-strip-types tests/e2e.test.ts",
    "clean": "rm -rf dist",
    "dev": "dsh web --patch cordis.yml"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jsdom": "^30.0.1",
    "tsdown": "^0.11.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  }
}
